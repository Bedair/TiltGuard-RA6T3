################################################################################
# TiltGuard build ID (hand-written, tracked - not an e2 studio generated file).
#
# e2 studio's generated Debug/makefile starts with "-include ../makefile.init",
# so this runs at the start of every build, with Debug/ as the working
# directory. It writes src/build_info_gen.h (git-ignored) with the firmware
# directory's git hash and a dirty flag (any modified, staged or untracked
# file under firmware/). src/build_info.c turns that into g_build_id, which
# the boot banner and the black-box recorder print, so every log says which
# build made it.
#
# The header is rewritten on every build, so build_info.c (and only it) is
# recompiled each time and its __DATE__/__TIME__ tells two dirty builds of the
# same commit apart. Only plain git commands are run - no shell syntax - so it
# works whether make's shell is busybox sh or cmd.exe. If git can't be run,
# the hash is "nogit" and the build is marked dirty.
################################################################################

BUILD_INFO_GIT_HASH := $(strip $(shell git -C .. rev-parse --short=7 HEAD))
BUILD_INFO_GIT_STATUS := $(strip $(shell git -C .. status --porcelain -- .))

ifeq ($(BUILD_INFO_GIT_HASH),)
BUILD_INFO_GIT_HASH := nogit
BUILD_INFO_GIT_DIRTY := 1
else ifeq ($(BUILD_INFO_GIT_STATUS),)
BUILD_INFO_GIT_DIRTY := 0
else
BUILD_INFO_GIT_DIRTY := 1
endif

define BUILD_INFO_GEN_TEXT
/* Generated by firmware/makefile.init on every build - do not edit, do not commit. */
#define BUILD_INFO_GIT_HASH  "$(BUILD_INFO_GIT_HASH)"
#define BUILD_INFO_GIT_DIRTY ($(BUILD_INFO_GIT_DIRTY))
endef

$(file >../src/build_info_gen.h,$(BUILD_INFO_GEN_TEXT))
